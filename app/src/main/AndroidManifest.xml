<?xml version="1.0" encoding="utf-8"?>
<!--
    TriggerChain — AndroidManifest.xml
    Include these declarations in your app's AndroidManifest.xml
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.triggerchain">

    <!-- ══════════════════════════════════════════════════
         PERMISSIONS
    ══════════════════════════════════════════════════ -->

    <!-- UsageStatsManager: user must grant via Settings > Apps > Special access -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- WorkManager background processing -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Required to query installed packages for app name resolution -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".TriggerChainApp"
        android:allowBackup="false"
        android:label="@string/app_name">

        <!-- ══════════════════════════════════════════════
             ACCESSIBILITY SERVICE
        ══════════════════════════════════════════════ -->
        <service
            android:name=".service.TriggerAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ══════════════════════════════════════════════
             WORK MANAGER WORKERS  (declared automatically
             via WorkManager's initializer; listed here
             for documentation clarity)
        ══════════════════════════════════════════════ -->

        <!-- LoopMinerWorker    — runs every 15 min -->
        <!-- UsageSyncWorker   — runs every 15 min -->
        <!-- CleanupWorker     — runs daily         -->

    </application>

</manifest>
